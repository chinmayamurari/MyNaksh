#!/usr/bin/env bash
# Wrapper for Praxis `prx init --agent cursor`: the Cursor agent often prints a
# preamble before the first "--- risk-map.yaml ---" line; ICE.E8.F4 requires
# stdout to start with that marker exactly.
set -euo pipefail
REAL_AGENT="${HOME}/.local/bin/agent"
exec 3>&2
set -o pipefail
"$REAL_AGENT" "$@" 2>&3 | python3 -c '
import sys
MARKER = b"--- risk-map.yaml ---"
d = sys.stdin.buffer.read()
i = d.find(MARKER)
sys.stdout.buffer.write(d[i:] if i != -1 else d)
'
